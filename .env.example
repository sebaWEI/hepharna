# Copy to .env and fill in real values. Never commit .env.

# SQLite path. Relative paths are resolved from the backend/ directory.
DATABASE_URL=sqlite:///./data/hepha_rna.sqlite

# Generate a long random string for production.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=12

FRONTEND_URL=http://localhost:3000

# Production on Digital Ocean: uvicorn serves API + frontend on one port.
# SERVE_FRONTEND=true
# FRONTEND_URL=http://YOUR_DROPLET_IP:3000

# RNA constraints
MIN_RNA_LENGTH=10
MAX_RNA_LENGTH=100

# Submission limit per user (set very high to effectively disable)
MAX_SUBMISSIONS_PER_USER=5

# ISO 8601, timezone aware. Leave empty to keep the challenge always open.
# Example: 2026-09-09T09:00:00+08:00
CHALLENGE_START_TIME=
CHALLENGE_END_TIME=

# Optional Minecraft Bio Lab info
MINECRAFT_SERVER_ADDRESS=
MINECRAFT_INFO=

# Used by the backup script
BACKUP_DIR=../backups
