[Unit]
Description=HEPHA-RNA Design Challenge
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/hepharna/backend
EnvironmentFile=/hepharna/.env
ExecStart=/hepharna/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 3000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
